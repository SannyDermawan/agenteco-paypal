# Copy to .env (git-ignored). Names only here, never real values.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps and credentials > Sandbox). The service refuses a live base URL.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the webhook you subscribed to PAYMENT.CAPTURE.COMPLETED, needed to verify webhook signatures.
PAYPAL_WEBHOOK_ID=
# Where PayPal sends the buyer back after approving (the demo page).
PUBLIC_BASE_URL=http://localhost:8788
# Sandbox personal account email that receives the demo payout (optional; without it the payout is simulated and labelled).
DEMO_SELLER_PAYPAL_EMAIL=

# Fixed demo rate, disclosed in the README: how many test tokens one USD buys.
USD_TO_TOKEN=1

# AgentEco buyer side (testnet only)
CUSTODIAL_PRIVATE_KEY=
AGENTECO_API_URL=
# Any OpenAI-compatible model for the buyer agent (Groq, Gemini through its OpenAI endpoint, Nebius, ...).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

PORT=8788
DATA_FILE=
